# Unity temporary & local cache (automatically regenerated by Unity Editor)
src/kiosk_unity/Library/
src/kiosk_unity/Temp/
src/kiosk_unity/Obj/
src/kiosk_unity/Logs/
src/kiosk_unity/MemoryCaptures/
src/kiosk_unity/UserSettings/
src/kiosk_unity/.vscode/
src/kiosk_unity/*.csproj
src/kiosk_unity/*.sln
src/kiosk_unity/*.slnx
src/kiosk_unity/*.log

# Runtime generated audio cache (except pre-cached offline failsafe MP3s in audio_cache/), local SSL certs, & SQLite DB
src/backend/static/audio/*.mp3
src/backend/static/photos/*.jpg
src/backend/*.pem
__pycache__/
*.pyc
*.db
.env
