kiosk_unity/.vscode/
kiosk_unity/*.csproj
kiosk_unity/*.sln
kiosk_unity/*.slnx
kiosk_unity/*.log

# Runtime generated audio cache, local SSL certs, & SQLite DB
backend/static/audio/*.mp3
backend/*.pem
__pycache__/
*.pyc
*.db
.env
