# ==========================================
# Lunar Aurora Environment Configuration
# ==========================================

# Groq API Key for Llama 3 Multilingual Historical Guide
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Text-to-Speech Default Voice
DEFAULT_VOICE=en-US-ChristopherNeural

# Database Configuration
# Local SQLite (Development fallback - no installation needed):
DATABASE_URL=sqlite:///./lunar_aurora.db

# Or PostgreSQL with PostGIS (Production / Ubuntu Linux):
# ENABLE_POSTGRES=1
# POSTGIS_URL=postgresql://luna:aurora123@localhost:5432/lunar_aurora

# Server Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=True

